{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": ".build.noindex/modules"
  },
  "include": ["src/**/*.mts", "src/**/*.d.ts"]
}
